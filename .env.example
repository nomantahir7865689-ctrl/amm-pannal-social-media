# Example environment file for Amm Pannal Social Media Services
# Copy this file to .env and add your actual API keys
# NEVER commit the .env file to version control!

# ============================================
# FACEBOOK & INSTAGRAM APIs
# ============================================
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_KEY=

# ============================================
# TWITTER API
# ============================================
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ============================================
# TIKTOK API
# ============================================
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_API_KEY=

# ============================================
# LINKEDIN API
# ============================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_KEY=

# ============================================
# YOUTUBE API
# ============================================
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ============================================
# GENERAL CONFIGURATION
# ============================================
NODE_ENV=development
DEBUG=true
PORT=3000
